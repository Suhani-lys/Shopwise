# ==============================================================================
# ShopWise Backend Environment Configuration Example
# Copy this file to "server/.env" and fill in your actual credentials.
# NOTE: "server/.env" is git-ignored and will NEVER be pushed to GitHub.
# ==============================================================================

# Server Network Port (Default: 5000)
PORT=5000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Allowed Frontend Origins (CORS Whitelist for Production)
# Comma-separated list of authorized domains (e.g. https://shopwise.vercel.app,https://shopwise.in)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================================================
# MongoDB Database Connection URI (Required for persistent storage)
# ==============================================================================
# Option A: MongoDB Atlas (Recommended Cloud Free Cluster)
#   1. Sign in to https://cloud.mongodb.com and create a free M0 cluster.
#   2. In "Database Access", create a database user (e.g. "shopwise_admin") with a strong password.
#   3. In "Network Access", add IP address: 0.0.0.0/0 (allow from anywhere) or your current IP.
#   4. Click "Connect" -> "Drivers" -> Copy the connection string.
#   5. Replace <password> with your user's password and append "/shopwise" before the query params.
#   Example:
#   MONGO_URI=mongodb+srv://shopwise_admin:MySuperPassword123@cluster0.abcde.mongodb.net/shopwise?retryWrites=true&w=majority
#
# Option B: Local MongoDB Daemon (if installed on your development machine)
#   MONGO_URI=mongodb://127.0.0.1:27017/shopwise
MONGO_URI=mongodb://127.0.0.1:27017/shopwise

# ==============================================================================
# Authentication Security (JWT Secret Key)
# ==============================================================================
# Replace with a cryptographically secure random string for signing user session tokens
# Generate one using terminal: openssl rand -base64 32
JWT_SECRET=replace_with_your_secure_random_jwt_secret_key_here

# ==============================================================================
# Live Shopping Platform Provider Integrations (Optional)
# Configure these keys to enable live real-time price queries from Indian merchants.
# Unconfigured providers fail gracefully and automatically rely on the persistent catalog.
# ==============================================================================

# 1. Flipkart Affiliate API
# Obtain from: https://affiliate.flipkart.com/api/api-token (Legacy accounts or affiliate networks)
FLIPKART_AFFILIATE_ID=your_flipkart_tracking_id_here
FLIPKART_AFFILIATE_TOKEN=your_flipkart_affiliate_token_here

# 2. Amazon India Creators / Product Advertising API (PA-API v5)
# Obtain from: https://affiliate-program.amazon.in/ (Requires active associate tag & 3 qualifying sales)
AMAZON_ACCESS_KEY=your_amazon_access_key_here
AMAZON_SECRET_KEY=your_amazon_secret_key_here
AMAZON_PARTNER_TAG=your_amazon_associate_tag_here
AMAZON_REGION=eu-west-1

# 3. Google Shopping India Multi-Store Live Aggregator (SerpApi)
# Aggregates live prices across Flipkart, Amazon.in, Croma, Reliance Digital, and Myntra
# Obtain a free key from: https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_key_here

# 4. Cuelinks Indian Multi-Store Affiliate Feed
# Covers Croma, Myntra, Tata CLiQ, Nykaa, and Ajio campaigns
# Obtain from: https://www.cuelinks.com/
CUELINKS_API_KEY=your_cuelinks_api_token_here

# ==============================================================================
# Phase 3: Automated Price Monitoring & Notification Delivery
# ==============================================================================

# Background Price Check Frequency in minutes (Default: 15)
PRICE_CHECK_INTERVAL_MINUTES=15

# Transactional Email Notification Delivery (SMTP)
# Options: Gmail App Password, SendGrid, Amazon SES, Mailgun, Brevo, or any SMTP host
# If left empty, ShopWise saves alerts and delivers in-app notifications without crashing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here
EMAIL_FROM="ShopWise Price Alerts" <alerts@shopwise.in>

