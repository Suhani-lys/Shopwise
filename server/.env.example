# ==============================================================================
# ShopWise Backend Environment Configuration Example
# Copy this file to .env and adjust variables for your local/production environment
# ==============================================================================

# Server Network Port (Default: 5000)
PORT=5000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# MongoDB Connection URI
# Local MongoDB: mongodb://127.0.0.1:27017/shopwise
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.example.mongodb.net/shopwise?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/shopwise

# JSON Web Token Secret Key
# WARNING: Replace with a cryptographically secure random string in production (e.g. openssl rand -base64 32)
JWT_SECRET=replace_with_your_secure_random_jwt_secret_key_here
